    "modernization:validate": "node scripts/validate-modernization.js",
    "homepage:validate": "node scripts/validate-homepage.js",
    "listings:validate": "node scripts/validate-listings.js",
    "search:validate": "node scripts/validate-search.js",
    "product-detail:validate": "node scripts/validate-product-detail.js",
    "cart:validate": "node scripts/validate-cart.js",
    "checkout:validate": "node scripts/validate-checkout.js",
    "account:validate": "node scripts/validate-account.js",
    "responsive:validate": "node scripts/validate-responsive.js",
    "accessibility:validate": "node scripts/validate-accessibility.js",
    "micro-interactions:validate": "node scripts/validate-micro-interactions.js",
    "production:validate": "node scripts/validate-production-readiness.js",
    "prebuild": "npm run production:validate",
    "refresh:validate": "node scripts/validate-refresh.js",
    "test:coverage": "jest --config jest.config.cjs --coverage"
