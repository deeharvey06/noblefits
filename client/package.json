    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "design-system:validate": "node scripts/validate-design-system.js",
    "shell:validate": "node scripts/validate-shell.js",
